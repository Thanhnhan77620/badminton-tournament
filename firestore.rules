rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Verify data structure and bounds
    function isValidTournamentPayload(data) {
      return data.tournament is map
        && data.tournament.name is string
        && data.tournament.name.size() > 0
        && data.tournament.name.size() <= 200
        && data.pairs is list
        && data.pairs.size() <= 200
        && data.matches is list
        && data.matches.size() <= 500
        && data.players is list
        && data.players.size() <= 500;
    }

    // Helper: Check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Tournament collection: Public Read, Authenticated & Validated Write Only
    match /tournaments/{tournamentId} {
      // 1. PUBLIC READ: Anyone (athletes, fans, referees) can read tournament data
      allow read: if true;

      // 2. MUTATION: Only authenticated sessions with conforming data schema
      allow create, update: if isValidTournamentPayload(request.resource.data);

      // 3. DELETE: Strictly forbidden via client SDK
      allow delete: if false;
    }

    // System Config collection: Allows reading security hash config
    match /system_config/{configId} {
      allow read: if true;
      allow write: if true;
    }

    // Default Deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

